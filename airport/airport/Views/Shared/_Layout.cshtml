<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] – SkyLine Air</title>
    <style>
        /* ══════════════════════════════════════
           COLOR PALETTE
           Black:  #0d0d0d / #1a1a1a / #222
           Silver: #c0c0c0 / #d4d4d4 / #e8e8e8
           Gold:   #c9a84c / #e2b94b / #f0d080
           Camel:  #c19a6b / #a0785a / #d4aa7d
        ══════════════════════════════════════ */

        :root {
            --black:      #0d0d0d;
            --black2:     #1a1a1a;
            --black3:     #252525;
            --silver:     #c0c0c0;
            --silver2:    #d8d8d8;
            --silver3:    #f0f0f0;
            --gold:       #c9a84c;
            --gold2:      #e2b94b;
            --gold3:      #f0d080;
            --camel:      #c19a6b;
            --camel2:     #a0785a;
            --camel3:     #d4aa7d;
            --white:      #ffffff;
            --danger:     #c0392b;
            --success:    #1e8449;
        }

        * { margin: 0; padding: 0; box-sizing: border-box; }

        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background: var(--black);
            color: var(--silver2);
            min-height: 100vh;
        }

        /* ── Scrollbar ── */
        ::-webkit-scrollbar { width: 6px; }
        ::-webkit-scrollbar-track { background: var(--black2); }
        ::-webkit-scrollbar-thumb { background: var(--gold); border-radius: 3px; }

        /* ══ NAVBAR ══ */
        .navbar {
            background: linear-gradient(90deg, var(--black) 0%, var(--black2) 100%);
            border-bottom: 2px solid var(--gold);
            padding: 0 24px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            height: 68px;
            position: sticky;
            top: 0;
            z-index: 1000;
            box-shadow: 0 4px 24px rgba(201,168,76,0.15);
        }

        .navbar-brand {
            display: flex;
            align-items: center;
            gap: 10px;
            text-decoration: none;
            font-size: 1.35em;
            font-weight: 800;
            letter-spacing: 2px;
            color: var(--gold);
        }
        .navbar-brand span { color: var(--silver); font-weight: 400; font-size: 0.75em; letter-spacing: 3px; display: block; line-height: 1; }
        .brand-icon { font-size: 1.6em; }

        /* hamburger */
        .hamburger {
            display: none;
            flex-direction: column;
            gap: 5px;
            cursor: pointer;
            padding: 6px;
            background: none;
            border: none;
        }
        .hamburger span {
            display: block;
            width: 26px;
            height: 2px;
            background: var(--gold);
            border-radius: 2px;
            transition: all 0.3s;
        }

        .nav-links {
            display: flex;
            align-items: center;
            gap: 4px;
            list-style: none;
        }

        .nav-links a {
            color: var(--silver);
            text-decoration: none;
            padding: 8px 13px;
            border-radius: 6px;
            font-size: 0.88em;
            font-weight: 500;
            letter-spacing: 0.5px;
            transition: all 0.25s;
            display: flex;
            align-items: center;
            gap: 6px;
            white-space: nowrap;
        }
        .nav-links a:hover {
            background: rgba(201,168,76,0.15);
            color: var(--gold);
        }
        .nav-links a.active {
            background: linear-gradient(135deg, rgba(201,168,76,0.25), rgba(193,154,107,0.2));
            color: var(--gold2);
            border: 1px solid rgba(201,168,76,0.3);
        }

        /* ══ ALERTS ══ */
        .alert-wrap { padding: 14px 24px 0; }
        .alert {
            padding: 13px 20px;
            border-radius: 8px;
            font-size: 0.93em;
            font-weight: 500;
            display: flex;
            align-items: center;
            gap: 10px;
        }
        .alert-success {
            background: rgba(30,132,73,0.15);
            border: 1px solid rgba(30,132,73,0.4);
            color: #58d68d;
        }
        .alert-error {
            background: rgba(192,57,43,0.15);
            border: 1px solid rgba(192,57,43,0.4);
            color: #ec7063;
        }

        /* ══ MAIN CONTENT ══ */
        .main-content {
            padding: 28px 24px;
            max-width: 1300px;
            margin: 0 auto;
        }

        /* ══ PAGE HEADER ══ */
        .page-header {
            background: linear-gradient(135deg, var(--black2) 0%, var(--black3) 100%);
            border: 1px solid rgba(201,168,76,0.2);
            border-left: 4px solid var(--gold);
            border-radius: 10px;
            padding: 24px 28px;
            margin-bottom: 24px;
            display: flex;
            align-items: center;
            gap: 16px;
        }
        .page-header-icon { font-size: 2.2em; }
        .page-header h1 { font-size: 1.7em; color: var(--gold); font-weight: 700; letter-spacing: 1px; }
        .page-header p { color: var(--silver); font-size: 0.9em; margin-top: 3px; }

        /* ══ CARDS ══ */
        .card {
            background: linear-gradient(145deg, var(--black2), var(--black3));
            border: 1px solid rgba(201,168,76,0.15);
            border-radius: 12px;
            padding: 28px;
            margin-bottom: 24px;
            box-shadow: 0 8px 32px rgba(0,0,0,0.4);
        }
        .card-title {
            font-size: 1.1em;
            font-weight: 700;
            color: var(--gold);
            letter-spacing: 1px;
            margin-bottom: 22px;
            padding-bottom: 12px;
            border-bottom: 1px solid rgba(201,168,76,0.2);
            display: flex;
            align-items: center;
            gap: 8px;
        }

        /* ══ FORM ══ */
        .form-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 18px; }
        .form-grid-3 { display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 18px; }
        .form-group { display: flex; flex-direction: column; gap: 6px; }
        .form-group.full { grid-column: 1 / -1; }

        .form-group label {
            font-size: 0.82em;
            font-weight: 600;
            color: var(--camel3);
            letter-spacing: 0.8px;
            text-transform: uppercase;
        }

        .form-group input,
        .form-group select {
            background: var(--black);
            border: 1px solid rgba(201,168,76,0.25);
            border-radius: 7px;
            padding: 11px 14px;
            color: var(--silver2);
            font-size: 0.95em;
            transition: all 0.25s;
            outline: none;
            width: 100%;
        }
        .form-group input::placeholder { color: #555; }
        .form-group input:focus,
        .form-group select:focus {
            border-color: var(--gold);
            box-shadow: 0 0 0 3px rgba(201,168,76,0.12);
        }
        .form-group select option { background: var(--black2); color: var(--silver2); }

        .btn-row { display: flex; gap: 12px; margin-top: 8px; flex-wrap: wrap; }

        .btn {
            padding: 11px 26px;
            border: none;
            border-radius: 7px;
            font-size: 0.93em;
            font-weight: 700;
            cursor: pointer;
            letter-spacing: 0.5px;
            transition: all 0.25s;
            text-decoration: none;
            display: inline-flex;
            align-items: center;
            gap: 7px;
        }
        .btn-gold {
            background: linear-gradient(135deg, var(--gold), var(--camel));
            color: var(--black);
        }
        .btn-gold:hover { background: linear-gradient(135deg, var(--gold2), var(--camel3)); transform: translateY(-1px); box-shadow: 0 6px 20px rgba(201,168,76,0.3); }
        .btn-ghost {
            background: transparent;
            border: 1px solid rgba(201,168,76,0.3);
            color: var(--silver);
        }
        .btn-ghost:hover { border-color: var(--gold); color: var(--gold); }

        /* ══ TABLE ══ */
        .table-wrap { overflow-x: auto; border-radius: 8px; }
        table { width: 100%; border-collapse: collapse; min-width: 600px; }
        thead tr {
            background: linear-gradient(90deg, var(--black), #2a2200);
            border-bottom: 2px solid var(--gold);
        }
        thead th {
            padding: 13px 16px;
            text-align: left;
            font-size: 0.78em;
            font-weight: 700;
            color: var(--gold);
            letter-spacing: 1.2px;
            text-transform: uppercase;
            white-space: nowrap;
        }
        tbody tr {
            border-bottom: 1px solid rgba(201,168,76,0.07);
            transition: background 0.2s;
        }
        tbody tr:hover { background: rgba(201,168,76,0.05); }
        tbody td {
            padding: 13px 16px;
            font-size: 0.9em;
            color: var(--silver2);
            vertical-align: middle;
        }
        .empty-msg td {
            text-align: center;
            padding: 40px;
            color: #555;
            font-size: 0.95em;
        }

        /* ══ BADGES ══ */
        .badge {
            display: inline-block;
            padding: 4px 11px;
            border-radius: 20px;
            font-size: 0.78em;
            font-weight: 700;
            letter-spacing: 0.5px;
        }
        .badge-gold    { background: rgba(201,168,76,0.2);  color: var(--gold2); border: 1px solid rgba(201,168,76,0.3); }
        .badge-silver  { background: rgba(192,192,192,0.1); color: var(--silver); border: 1px solid rgba(192,192,192,0.2); }
        .badge-camel   { background: rgba(193,154,107,0.15);color: var(--camel3); border: 1px solid rgba(193,154,107,0.3); }
        .badge-green   { background: rgba(30,132,73,0.15);  color: #58d68d; border: 1px solid rgba(30,132,73,0.3); }
        .badge-red     { background: rgba(192,57,43,0.15);  color: #ec7063; border: 1px solid rgba(192,57,43,0.3); }
        .badge-blue    { background: rgba(41,128,185,0.15); color: #7fb3d3; border: 1px solid rgba(41,128,185,0.3); }

        /* ══ DELETE BUTTON ══ */
        .btn-delete {
            background: rgba(192,57,43,0.15);
            border: 1px solid rgba(192,57,43,0.3);
            color: #ec7063;
            padding: 5px 12px;
            border-radius: 5px;
            font-size: 0.82em;
            font-weight: 700;
            cursor: pointer;
            transition: all 0.2s;
            letter-spacing: 0.3px;
        }
        .btn-delete:hover { background: rgba(192,57,43,0.35); border-color: #ec7063; }

        /* ══ FOOTER ══ */
        footer {
            text-align: center;
            padding: 20px;
            border-top: 1px solid rgba(201,168,76,0.15);
            color: #444;
            font-size: 0.8em;
            letter-spacing: 1px;
            margin-top: 40px;
        }
        footer span { color: var(--gold); }

        /* ══ MOBILE RESPONSIVE ══ */
        @@media (max-width: 768px) {
            .hamburger { display: flex; }

            .nav-links {
                display: none;
                position: fixed;
                top: 68px;
                left: 0;
                right: 0;
                background: var(--black2);
                border-bottom: 2px solid var(--gold);
                flex-direction: column;
                padding: 16px;
                gap: 6px;
                z-index: 999;
                box-shadow: 0 12px 40px rgba(0,0,0,0.6);
            }
            .nav-links.open { display: flex; }
            .nav-links a { width: 100%; padding: 12px 16px; font-size: 0.95em; }

            .form-grid, .form-grid-3 { grid-template-columns: 1fr; }
            .form-group.full { grid-column: 1; }

            .main-content { padding: 16px 14px; }
            .page-header { padding: 18px; flex-direction: column; align-items: flex-start; gap: 8px; }
            .page-header h1 { font-size: 1.3em; }
            .card { padding: 18px; }

            thead th, tbody td { padding: 10px 12px; font-size: 0.82em; }
        }

        @@media (max-width: 480px) {
            .navbar { padding: 0 14px; }
            .navbar-brand { font-size: 1.1em; }
            .btn { padding: 10px 18px; font-size: 0.88em; }
        }
    </style>
</head>
<body>

<nav class="navbar">
    <a class="navbar-brand" asp-controller="Home" asp-action="Index">
        <span class="brand-icon">✈</span>
        <div>
            SKYLINE AIR
            <span>MANAGEMENT SYSTEM</span>
        </div>
    </a>

    <button class="hamburger" onclick="toggleMenu()" aria-label="Menu">
        <span></span><span></span><span></span>
    </button>

    <ul class="nav-links" id="navLinks">
        <li><a asp-controller="Home"        asp-action="Index">🏠 Home</a></li>
        <li><a asp-controller="Aircraft"    asp-action="Index">🛩 Aircraft</a></li>
        <li><a asp-controller="Airport"     asp-action="Index">🏢 Airports</a></li>
        <li><a asp-controller="Flight"      asp-action="Index">✈ Flights</a></li>
        <li><a asp-controller="Passenger"   asp-action="Index">👤 Passengers</a></li>
        <li><a asp-controller="Staff"       asp-action="Index">👨‍✈️ Staff</a></li>
        <li><a asp-controller="Ticket"      asp-action="Index">🎫 Tickets</a></li>
        <li><a asp-controller="CrewDetails" asp-action="Index">👩‍✈️ Crew</a></li>
    </ul>
</nav>

@if (TempData["Success"] != null)
{
    <div class="alert-wrap">
        <div class="alert alert-success">✅ @TempData["Success"]</div>
    </div>
}
@if (TempData["Error"] != null)
{
    <div class="alert-wrap">
        <div class="alert alert-error">⚠️ @TempData["Error"]</div>
    </div>
}

<div class="main-content">
    @RenderBody()
</div>

<footer>
    &copy; 2025 <span>SKYLINE AIR</span> — Airline Management System
</footer>

<script>
    function toggleMenu() {
        document.getElementById('navLinks').classList.toggle('open');
    }
    // Close menu on outside click
    document.addEventListener('click', function(e) {
        var nav = document.getElementById('navLinks');
        var btn = document.querySelector('.hamburger');
        if (!nav.contains(e.target) && !btn.contains(e.target)) {
            nav.classList.remove('open');
        }
    });
</script>

</body>
</html>
