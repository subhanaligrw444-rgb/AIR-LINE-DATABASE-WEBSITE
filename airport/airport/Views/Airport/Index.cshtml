@model IEnumerable<airline_system.Models.Airport>
@{
    ViewData["Title"] = "Airports";
}

<div class="page-header">
    <div class="page-header-icon">🏢</div>
    <div>
        <h1>AIRPORT DIRECTORY</h1>
        <p>View and manage all airport records worldwide</p>
    </div>
</div>

<!-- ADD FORM -->
<div class="card">
    <div class="card-title">➕ Add New Airport</div>
    <form asp-controller="Airport" asp-action="Create" method="post">
        @Html.AntiForgeryToken()
        <div class="form-grid">
            <div class="form-group">
                <label>Airport Name</label>
                <input type="text" name="Name" required placeholder="e.g., Allama Iqbal International" />
            </div>
            <div class="form-group">
                <label>IATA Code</label>
                <input type="text" name="IATA_Code" required placeholder="e.g., LHE" maxlength="3" style="text-transform:uppercase" />
            </div>
            <div class="form-group">
                <label>City</label>
                <input type="text" name="City" required placeholder="e.g., Lahore" />
            </div>
            <div class="form-group">
                <label>Country</label>
                <input type="text" name="Country_Name" required placeholder="e.g., Pakistan" />
            </div>
        </div>
        <div class="btn-row">
            <button type="submit" class="btn btn-gold">🏢 Add Airport</button>
            <button type="reset" class="btn btn-ghost">✕ Clear</button>
        </div>
    </form>
</div>

<!-- TABLE -->
<div class="card">
    <div class="card-title">🌍 All Airports — @Model.Count() Records</div>
    <div class="table-wrap">
        <table>
            <thead>
                <tr>
                    <th>#ID</th>
                    <th>Airport Name</th>
                    <th>IATA</th>
                    <th>City</th>
                    <th>Country</th>
                    <th>Action</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr class="empty-msg"><td colspan="6">No airports found. Add one above.</td></tr>
                }
                else
                {
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td><span class="badge badge-silver">@item.Airport_ID</span></td>
                            <td><strong style="color:var(--silver2)">@item.Name</strong></td>
                            <td><span class="badge badge-gold">@item.IATA_Code</span></td>
                            <td>@item.City</td>
                            <td><span class="badge badge-camel">@item.Country_Name</span></td>
                            <td>
                                <form asp-controller="Airport" asp-action="Delete"
                                      asp-route-id="@item.Airport_ID" method="post"
                                      style="display:inline"
                                      onsubmit="return confirm('Are you sure you want to delete this airport?')">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn-delete">🗑 Delete</button>
                                </form>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>
